def top_keywords(text: str, k: int = 3) -> list[Optional[str]]:
    if not text or not str(text).strip():
        return [None, None, None]
    text_l = str(text).lower()
    toks = []
    for tok in TOKEN_RE.findall(text_l):
        if tok in STOPWORDS:
            continue
        toks.append(tok)
    c = Counter(toks)
    top = [w for w, _ in c.most_common(k)]
    while len(top) < 3:
        top.append(None)
    return top[:3]

def ensure_target_schema(conn: sqlite3.Connection) -> None:
    cur = conn.cursor()
    cur.execute(f"""
        CREATE TABLE IF NOT EXISTS {TARGET_TABLE} (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            publishedAt TEXT,
            url TEXT,
            source_name TEXT,
            source_url TEXT,
            title_en TEXT,
            description_en TEXT,
            article_country TEXT,
            article_country_score INTEGER,
            event_type TEXT
        );
    """)
    cur.execute(f"CREATE INDEX IF NOT EXISTS idx_{TARGET_TABLE}_publishedAt ON {TARGET_TABLE}(publishedAt);")
    cur.execute(f"CREATE INDEX IF NOT EXISTS idx_{TARGET_TABLE}_article_country ON {TARGET_TABLE}(article_country);")
    cur.execute(f"CREATE INDEX IF NOT EXISTS idx_{TARGET_TABLE}_url ON {TARGET_TABLE}(url);")
    conn.commit()


def clear_target_table(conn: sqlite3.Connection) -> None:
    cur = conn.cursor()
    cur.execute(f"DELETE FROM {TARGET_TABLE};")
    cur.execute("DELETE FROM sqlite_sequence WHERE name = ?;", (TARGET_TABLE,))
    conn.commit()

def fetch_source_batches(conn: sqlite3.Connection, batch_size: int, limit: Optional[int] = None):
    cur = conn.cursor()
    base_sql = f"""
        SELECT
            publishedAt,
            title,
            description,
            content,
            url,
            source_name,
            source_url
        FROM {SOURCE_TABLE}
        ORDER BY rowid
    """
    if limit is not None:
        base_sql += f" LIMIT {int(limit)}"
    cur.execute(base_sql)
    while True:
        rows = cur.fetchmany(batch_size)
        if not rows:
            break
        yield rows

def translate_texts(translator, texts: list[str]) -> list[str]:
    texts = [t if isinstance(t, str) else "" for t in texts]
    if all((not t.strip()) for t in texts):
        return ["" for _ in texts]
    outputs = translator(texts, batch_size=16, truncation=True)
    return [o["translation_text"] for o in outputs]

def classify_one(acled_classifier, text_de: str) -> str:
    if not text_de or not str(text_de).strip():
        return "Other"
    try:
        res = acled_classifier(
            str(text_de),
            candidate_labels=ACLED_EVENT_TYPES,
            truncation=True,
        )
        return res["labels"][0] if res.get("labels") else "Other"
    except Exception:
        return "Other"

def to_date_yyyy_mm_dd(published_at: Optional[str]) -> Optional[str]:
    if not published_at:
        return None
    s = str(published_at)
    return s[:10] if len(s) >= 10 else None

def insert_batch(conn, batch_rows, translator, acled_classifier, country_aliases, country_classifier) -> None:
    publishedAt = [r[0] for r in batch_rows]
    title_de = [r[1] for r in batch_rows]
    desc_de = [r[2] for r in batch_rows]
    content_de = [r[3] for r in batch_rows]
    url = [r[4] for r in batch_rows]
    source_name = [r[5] for r in batch_rows]
    source_url = [r[6] for r in batch_rows]

    published_date = [to_date_yyyy_mm_dd(x) for x in publishedAt]

    title_en = translate_texts(translator, title_de)
    description_en = translate_texts(translator, desc_de)

    

    to_insert = []
    t_country = 0.0

    for i in range(len(batch_rows)):
        analysis_text_en = (title_en[i] or "") + " " + (description_en[i] or "")
        analysis_text_de = f"{title_de[i] or ''} {desc_de[i] or ''} {content_de[i] or ''}".strip()

        cand_scored = guess_country_candidates(analysis_text_en, country_aliases, k=COUNTRY_CANDIDATE_TOPK)
        candidates = [c for (c, _s) in cand_scored]

        t0 = time.perf_counter()
        if len(candidates) == 0:
            country, zs_score = None, 0.0
        elif len(candidates) == 1:
            country, zs_score = candidates[0], 1.0
        else:
            country, zs_score = choose_country_zero_shot(country_classifier, analysis_text_en, candidates)
        t_country += (time.perf_counter() - t0)

        event_type = classify_one(acled_classifier, analysis_text_de)

        to_insert.append((
            published_date[i], url[i], source_name[i], source_url[i],
            title_en[i], description_en[i],
            country, int(zs_score * 100),
            event_type,
        ))

    print(f"[batch] country_time_s={t_country:.2f} avg_country_ms={1000*t_country/len(batch_rows):.1f}")



    cur = conn.cursor()
    cur.executemany(f"""
        INSERT INTO {TARGET_TABLE} (
            publishedAt, url, source_name, source_url,
            title_en, description_en,
            article_country, article_country_score,
            event_type
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
    """, to_insert)
    conn.commit()


def main():
    print("cwd:", os.getcwd())
    print("PROJECT_ROOT:", PROJECT_ROOT)
    print("GNEWS_DB:", GNEWS_DB)
    print("CONFLICT_DB:", CONFLICT_DB)

    conflict_countries = load_conflict_countries(CONFLICT_DB)
    country_aliases = build_country_aliases_from_conflicts(conflict_countries)

    conn = sqlite3.connect(str(GNEWS_DB))
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA synchronous=NORMAL;")
    try:
        ensure_target_schema(conn)

        if CLEAR_TARGET_FIRST:
            print(f"Clearing target table: {TARGET_TABLE}")
            clear_target_table(conn)

        print(f"Loading translation model: {TRANSLATION_MODEL}")
        translator = pipeline("translation_de_to_en", model=TRANSLATION_MODEL)

        print(f"Loading ACLED zero-shot classifier: {ACLED_ZSC_MODEL}")
        acled_classifier = pipeline("zero-shot-classification", model=ACLED_ZSC_MODEL)

        print(f"Loading COUNTRY zero-shot classifier: {COUNTRY_ZSC_MODEL}")
        country_classifier = pipeline("zero-shot-classification", model=COUNTRY_ZSC_MODEL)

        total = 0
        for batch in fetch_source_batches(conn, BATCH_SIZE, TEST_LIMIT):
            insert_batch(conn, batch, translator, acled_classifier, country_aliases, country_classifier)
            total += len(batch)
            print(f"Processed: {total} rows")

        n = conn.execute(f"SELECT COUNT(*) FROM {TARGET_TABLE};").fetchone()[0]
        print(f"Done. {TARGET_TABLE} rows: {n}")

        # Fill missing country with Germany
        cur = conn.cursor()
        cur.execute(f"""
            UPDATE {TARGET_TABLE}
            SET article_country = 'Germany'
            WHERE article_country IS NULL OR TRIM(article_country) = '';
        """)
        conn.commit()
        print("Filled NULL/empty article_country with 'Germany'.")


    finally:
        conn.close()
        print("Closed DB connection.")

if __name__ == "__main__":
    main()
  